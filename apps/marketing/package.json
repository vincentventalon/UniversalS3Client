{
  "name": "universal-s3-client-website",
  "version": "1.0.0",
  "description": "Marketing site for Universal S3 Client — free, open-source S3 client for iPhone, iPad and Mac",
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "deploy": "node scripts/deploy-guard.mjs && npm run build && wrangler deploy --config wrangler-static.toml",
    "astro": "astro",
    "check": "npm run check:astro && npm run check:eslint && npm run check:prettier",
    "check:astro": "astro check",
    "check:eslint": "eslint .",
    "check:prettier": "prettier --check .",
    "fix": "npm run fix:eslint && npm run fix:prettier",
    "fix:eslint": "eslint --fix .",
    "fix:prettier": "prettier -w ."
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "3.7.3",
    "@fontsource-variable/inter": "^5.2.5",
    "@fontsource-variable/jetbrains-mono": "^5.2.5",
    "astro": "^7.4.4",
    "astro-embed": "^0.14.0",
    "astro-icon": "^1.2.0",
    "limax": "4.1.0",
    "lodash.merge": "^4.6.2",
    "unpic": "^4.1.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/markdown-remark": "^7.3.0",
    "@astrojs/mdx": "^8.1.2",
    "@astrojs/partytown": "^2.1.9",
    "@eslint/js": "^9.24.0",
    "@iconify-json/flat-color-icons": "^1.2.1",
    "@iconify-json/tabler": "^1.2.17",
    "@tailwindcss/typography": "^0.5.16",
    "@types/js-yaml": "^4.0.9",
    "@types/lodash.merge": "^4.6.9",
    "@types/mdx": "^2.0.13",
    "@typescript-eslint/eslint-plugin": "^8.30.1",
    "@typescript-eslint/parser": "^8.30.1",
    "astro-compress": "2.3.8",
    "astro-eslint-parser": "^1.2.2",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.1",
    "eslint": "^9.24.0",
    "eslint-plugin-astro": "^1.3.1",
    "globals": "^16.0.0",
    "js-yaml": "^4.1.0",
    "mdast-util-to-string": "^4.0.0",
    "prettier": "^3.5.3",
    "prettier-plugin-astro": "^0.14.1",
    "reading-time": "^1.5.0",
    "sharp": "0.34.1",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.30.1",
    "unist-util-visit": "^5.0.0",
    "wrangler": "^4.80.0"
  },
  "overrides": {
    "cookie": "^2.0.1",
    "youch": {
      "cookie": "^1.0.2"
    }
  }
}
