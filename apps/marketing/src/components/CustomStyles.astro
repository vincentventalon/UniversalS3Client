---
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
---

<style is:inline>
  /* Dark-only dev-tool theme: :root mirrors .dark so the page never flashes light. */
  :root,
  .dark {
    --aw-font-sans: 'Inter Variable';
    --aw-font-serif: 'Inter Variable';
    --aw-font-heading: 'Inter Variable';
    --aw-font-mono: 'JetBrains Mono Variable';

    --aw-color-primary: rgb(52 211 153);
    --aw-color-secondary: rgb(16 185 129);
    --aw-color-accent: rgb(52 211 153);

    --aw-color-text-heading: rgb(244 244 245);
    --aw-color-text-default: rgb(212 212 216);
    --aw-color-text-muted: rgb(161 161 170);
    --aw-color-bg-page: rgb(10 11 14);
    --aw-color-bg-panel: rgb(19 21 26);
    --aw-color-border: rgb(39 42 50);

    --aw-color-bg-page-dark: rgb(10 11 14);

    ::selection {
      background-color: rgb(52 211 153 / 25%);
      color: rgb(244 244 245);
    }
  }
</style>
