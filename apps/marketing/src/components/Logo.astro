---
import { Image } from 'astro:assets';
import { SITE } from 'astrowind:config';
import logo from '~/assets/images/logo.png';
---

<span
  class="flex items-center self-center rtl:ml-0 rtl:mr-2 text-2xl md:text-xl font-bold text-gray-900 whitespace-nowrap dark:text-white"
>
  <Image src={logo} alt={SITE?.name} width={32} height={32} class="w-8 h-8 rounded-lg" loading="eager" />
  <span class="ml-2">{SITE?.name}</span>
</span>
