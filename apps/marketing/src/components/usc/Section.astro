---
export interface Props {
  id?: string;
  kicker?: string;
  title?: string;
  intro?: string;
  classes?: string;
}

const { id, kicker, title, intro, classes = '' } = Astro.props;
---

<section id={id} class={`mx-auto max-w-6xl px-4 py-12 md:px-6 md:py-16 ${classes}`}>
  {kicker && <p class="mb-2 font-mono text-sm text-primary">{kicker}</p>}
  {title && <h2 class="mb-4 font-heading text-3xl font-bold tracking-tight text-heading md:text-4xl">{title}</h2>}
  {intro && <p class="mb-8 max-w-3xl text-lg text-muted">{intro}</p>}
  <slot />
</section>
