---
export interface Props {
  items: { q: string; a: string }[];
}

const { items } = Astro.props;
---

<div class="flex flex-col gap-3">
  {
    items.map((item) => (
      <details class="panel group px-5 py-4">
        <summary class="cursor-pointer list-none font-semibold text-heading marker:content-none">
          <span class="mr-2 font-mono text-primary transition-transform group-open:hidden">+</span>
          <span class="mr-2 hidden font-mono text-primary group-open:inline">−</span>
          {item.q}
        </summary>
        <p class="mt-3 text-muted">{item.a}</p>
      </details>
    ))
  }
</div>
